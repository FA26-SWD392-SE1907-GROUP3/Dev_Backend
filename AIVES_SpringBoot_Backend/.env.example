# Set these in IntelliJ Run Configuration / terminal environment (do not commit actual secrets).
# For Neon use Connection Details -> host, database, user and password.
# Direct endpoint recommended for initial local API, with Hikari max=5.
DB_URL=jdbc:postgresql://ep-EXAMPLE.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=5
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
