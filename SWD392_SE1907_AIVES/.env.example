# Copy to .env for local only (gitignored). Never commit real credentials.
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_WITH_NEW_ROTATED_PASSWORD
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# OpenAI API key stays on the backend. Leave empty to disable question generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Persistent disk location for original PDF/DOCX uploads.
MATERIAL_STORAGE_DIR=./storage/materials
INTERVIEW_STORAGE_DIR=./storage/interviews
OPENAI_INTERVIEW_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_STT_MODEL=gpt-live-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
